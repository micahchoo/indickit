{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist/types",
    "skipLibCheck": true
  },
  "files": [
    "js/phonetic.ts",
    "js/normalize.ts",
    "js/segment.ts",
    "js/stem.ts",
    "js/romanize.ts",
    "js/phonetic-search.ts",
    "js/deromanize.ts"
  ]
}
